Proceso Reguistro_de_Estudiante
	Definir nombre Como Caracter
    Definir Carrera Como Caracter
    Definir Universidad Como Caracter
    Definir curso Como caracter
    Definir nota1 Como Real	
	definir nota2 como real
	Definir nota3 Como Real
	Definir promedio Como Real
	
	Escribir "Ingrese su nombre:"
    Leer nombre
	
    Escribir "Ingrese su Carrera:"
    Leer Carrera
	
    Escribir "Ingrese nombre de Universidad:"
    Leer Universidad
	
	Escribir "Ingrese nombre de curso:"
    Leer curso
	
    Escribir "Ingrese Nota1:"
	leer nota1
	
	Escribir "Ingrese Nota2:"
	leer nota2
	
	Escribir "Ingrese Nota3:"
	leer nota3
	
	promedio <- (nota1 + nota2 + nota3)/3
	
    Escribir "Nombre de estudiante: ", nombre
    Escribir "Nombre de Carrera: ", Carrera
    Escribir "Nombre de Universidad: ", Universidad
    Escribir "Materia: ", curso
    Escribir "el promedio es de: ", promedio

	
	
FinProceso
