Proceso DatosCliente
	
    Definir nombre Como Caracter
    Definir ciudad Como Caracter
    Definir edad Como Entero
    Definir salario Como Real
    Definir salarioAnual Como Real
	
    Escribir "Ingrese su nombre:"
    Leer nombre
	
    Escribir "Ingrese su edad:"
    Leer edad
	
    Escribir "Ingrese su ciudad:"
    Leer ciudad
	
    Escribir "Ingrese su salario mensual:"
    Leer salario
	
    salarioAnual <- salario * 12
	
    Escribir "Nombre: ", nombre
    Escribir "Edad: ", edad, " años"
    Escribir "Ciudad: ", ciudad
    Escribir "Salario mensual: $", salario
    Escribir "Salario anual: $", salarioAnual
	
	
FinProceso